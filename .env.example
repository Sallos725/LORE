LORE_IMAGE=ghcr.io/sallos725/lore
LORE_VERSION=v0.1.0-alpha.2
# Generate a fresh token: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Replace ALL scope IDs with the stable IDs for one installation/user/character/chat/branch.
# collect permits cursor-based chat collection in this one scope. ingest remains false.
# Use the plugin current-chat-ID button after installing the host extension.
LORE_CREDENTIALS_JSON='[{"token":"REPLACE_WITH_RANDOM_TOKEN","scope":{"installationId":"replace-installation","userId":"replace-user","characterId":"replace-character","chatId":"replace-chat","branchId":"replace-branch"},"audience":"world","ingest":false,"collect":true}]'

# OpenAI-compatible extraction endpoint; no LLM calls until explicitly configured.
LORE_LLM_URL=
LORE_LLM_MODEL=
LORE_LLM_API_KEY=
LORE_LLM_TIMEOUT_MS=45000
LORE_LLM_JSON_MODE=false
