LORE_IMAGE=ghcr.io/sallos725/lore
# latest follows successful releases, including the current alpha. Pin a version to freeze updates.
LORE_VERSION=latest
# Optional docker-compose.http.yml binds here; use a private interface for phone access.
LORE_BIND_ADDRESS=127.0.0.1
LORE_PORT=6011
# Existing PocketRisu origin reachable FROM the sidecar; no app changes required.
LORE_POCKETRISU_URL=http://pocketrisu:6001
# Existing PocketRisu login authenticates the plugin automatically.
# No LORE token or character/chat IDs are needed.

# Optional default extraction model. Per-chat settings entered in the plugin
# persist in the private server data volume, including its API key.
LORE_LLM_PROVIDER=custom
LORE_LLM_URL=
LORE_LLM_MODEL=
LORE_LLM_API_KEY=
LORE_LLM_TIMEOUT_MS=45000
LORE_LLM_JSON_MODE=false
