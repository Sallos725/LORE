LORE_IMAGE=ghcr.io/sallos725/lore
LORE_VERSION=v0.1.0-alpha.1
# Generate a fresh token: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Replace ALL scope IDs with the stable IDs for one installation/user/character/chat/branch.
# This is a wiki UI token (no event ingestion). Never put an ingest token in a browser.
LORE_CREDENTIALS_JSON='[{"token":"REPLACE_WITH_RANDOM_TOKEN","scope":{"installationId":"replace-installation","userId":"replace-user","characterId":"replace-character","chatId":"replace-chat","branchId":"replace-branch"},"audience":"world","ingest":false}]'
