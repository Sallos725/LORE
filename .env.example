LORE_IMAGE=ghcr.io/sallos725/lore
# latest follows successful releases, including the current alpha. Pin a version to freeze updates.
LORE_VERSION=latest
# Optional docker-compose.http.yml binds here; use a private interface for phone access.
LORE_BIND_ADDRESS=127.0.0.1
LORE_PORT=6011
# Existing PocketRisu origin reachable FROM the sidecar; no app changes required.
LORE_POCKETRISU_URL=http://pocketrisu:6001
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# installation/user are operator-assigned. characterId is the existing stable host ID.
# configure permits provider settings and same-character chat-ID discovery only.
# Use the plugin ID button with a configure token, then set chatId=branchId to that ID.
LORE_CREDENTIALS_JSON='[{"token":"REPLACE_WITH_RANDOM_TOKEN","scope":{"installationId":"replace-installation","userId":"replace-user","characterId":"replace-character","chatId":"replace-chat","branchId":"replace-chat"},"audience":"world","ingest":false,"collect":true,"configure":true}]'

# Optional persistent extraction configuration. The plugin can instead send a
# scope-specific provider/model/key over HTTP; UI-supplied keys stay in RAM only.
LORE_LLM_PROVIDER=custom
LORE_LLM_URL=
LORE_LLM_MODEL=
LORE_LLM_API_KEY=
LORE_LLM_TIMEOUT_MS=45000
LORE_LLM_JSON_MODE=false
